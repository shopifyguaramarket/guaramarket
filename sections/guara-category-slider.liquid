{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #GuaraCategorySlider-{{ section.id }} .guara-category-slider__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #GuaraCategorySlider-{{ section.id }} .guara-category-slider__item {
    text-align: center;
  }

  #GuaraCategorySlider-{{ section.id }} .guara-category-slider__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #GuaraCategorySlider-{{ section.id }} .guara-category-slider__image-wrap {
    width: 100%;
    max-width: {{ section.settings.image_size }}px;
    aspect-ratio: 1 / 1;
    margin: 0 auto 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #GuaraCategorySlider-{{ section.id }} .guara-category-slider__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #GuaraCategorySlider-{{ section.id }} .guara-category-slider__title {
    margin: 0;
    font-size: 14px;
    line-height: 1.25;
    font-weight: 600;
    color: #2D6493;
  }

  #GuaraCategorySlider-{{ section.id }} .guara-category-slider__link:hover .guara-category-slider__title {
    color: #FF8702;
  }

  @media screen and (min-width: 990px) {
    #GuaraCategorySlider-{{ section.id }} .guara-category-slider__list.slider--desktop .slider__slide {
      width: calc((100% - ({{ section.settings.columns_desktop | minus: 1 }} * var(--grid-desktop-horizontal-spacing))) / {{ section.settings.columns_desktop }});
      max-width: calc((100% - ({{ section.settings.columns_desktop | minus: 1 }} * var(--grid-desktop-horizontal-spacing))) / {{ section.settings.columns_desktop }});
    }
  }
{%- endstyle -%}

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0

  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif

  assign show_desktop_slider = false
  if section.settings.enable_desktop_slider and section.blocks.size > section.settings.columns_desktop
    assign show_desktop_slider = true
  endif
-%}

<div
  id="GuaraCategorySlider-{{ section.id }}"
  class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper-with-link title-wrapper--no-top-margin">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endif -%}

    <slider-component
      class="slider-mobile-gutter{% if show_desktop_slider %} slider-component-desktop{% endif %}"
    >
      <ul
        id="Slider-{{ section.id }}"
        class="guara-category-slider__list grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down{% if show_mobile_slider or show_desktop_slider %} slider{% if show_desktop_slider %} slider--desktop{% endif %}{% if show_mobile_slider %} slider--tablet grid--peek{% endif %}{% endif %}"
        role="list"
        aria-label="Categorías destacadas"
      >
        {%- for block in section.blocks -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="guara-category-slider__item grid__item{% if show_mobile_slider or show_desktop_slider %} slider__slide{% endif %}"
            {{ block.shopify_attributes }}
          >
            <a
              class="guara-category-slider__link"
              {% if block.settings.link != blank %}
                href="{{ block.settings.link }}"
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
            >
              {%- if block.settings.image != blank -%}
                <div class="guara-category-slider__image-wrap">
                  {{
                    block.settings.image
                    | image_url: width: 500
                    | image_tag:
                      loading: 'lazy',
                      widths: '80, 120, 160, 200, 300, 400, 500',
                      class: 'guara-category-slider__image'
                  }}
                </div>
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <h3 class="guara-category-slider__title">
                  {{ block.settings.title }}
                </h3>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_mobile_slider or show_desktop_slider -%}
        <div class="slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>

          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>

          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>
  </div>
</div>

{% schema %}
{
  "name": "Categorías Guara",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título",
      "default": "Categorías destacadas"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        { "value": "h2", "label": "Pequeño" },
        { "value": "h1", "label": "Mediano" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Categorías visibles en escritorio",
      "min": 4,
      "max": 8,
      "step": 1,
      "default": 7
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Categorías visibles en móvil",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "3"
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Tamaño del vector",
      "min": 60,
      "max": 180,
      "step": 10,
      "unit": "px",
      "default": 110
    },
    {
      "type": "checkbox",
      "id": "enable_desktop_slider",
      "label": "Activar slider en escritorio",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "label": "Deslizar en móvil",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Vector / imagen"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Nombre de categoría",
          "default": "Categoría"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorías Guara",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
