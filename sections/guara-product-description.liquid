{%- if product.description != blank -%}
  <section class="guara-product-description section-{{ section.id }}-padding">
    <div class="page-width">

      <div class="guara-product-description__header">
        <span class="guara-product-description__eyebrow">
          Conocé tu producto
        </span>

        <h2 class="guara-product-description__title">
          Descripción del producto
        </h2>
      </div>

      <div class="guara-product-description__content rte">
        {{ product.description }}
      </div>

    </div>
  </section>
{%- endif -%}

<style>
  .guara-product-description {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: #ffffff;
  }

  .guara-product-description__header {
    max-width: 1100px;
    margin: 0 auto 26px;
  }

  .guara-product-description__eyebrow {
    display: inline-block;
    margin-bottom: 6px;
    color: #FF8702;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  .guara-product-description__title {
    margin: 0;
    color: #2D6493;
    font-size: 30px;
    line-height: 1.15;
    font-weight: 700;
  }

  .guara-product-description__content {
    max-width: 1100px;
    margin: 0 auto;
  }

  .guara-product-description__content img,
  .guara-product-description__content video,
  .guara-product-description__content iframe {
    display: block;
    width: 100%;
    max-width: 900px;
    height: auto;
    margin: 20px auto;
    border-radius: 12px;
  }

  .guara-product-description__content p {
    line-height: 1.7;
  }

  .guara-product-description__content h1,
  .guara-product-description__content h2,
  .guara-product-description__content h3 {
    color: #2D6493;
  }

  @media screen and (max-width: 749px) {
    .guara-product-description {
      padding-top: 28px;
      padding-bottom: 28px;
    }

    .guara-product-description__header {
      margin-bottom: 18px;
    }

    .guara-product-description__title {
      font-size: 24px;
    }

    .guara-product-description__content img,
    .guara-product-description__content video,
    .guara-product-description__content iframe {
      margin: 14px auto;
      border-radius: 8px;
    }
  }
</style>

{% schema %}
{
  "name": "Descripción producto Guara",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espacio superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espacio inferior",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Descripción producto Guara"
    }
  ]
}
{% endschema %}
