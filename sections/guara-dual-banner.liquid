<section
  id="GuaraDualBanner-{{ section.id }}"
  class="guara-dual-banner"
  style="
    --dual-gap: {{ section.settings.gap }}px;
    --dual-radius: {{ section.settings.radius }}px;
    --dual-desktop-height: {{ section.settings.desktop_height }}px;
    --dual-mobile-height: {{ section.settings.mobile_height }}px;
  "
>
  <div class="{% if section.settings.full_width %}guara-dual-banner__full{% else %}page-width{% endif %}">
    <div class="guara-dual-banner__grid">

      {% for block in section.blocks %}
        <div
          class="guara-dual-banner__item"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.link != blank %}
            <a
              href="{{ block.settings.link }}"
              class="guara-dual-banner__link"
              aria-label="{{ block.settings.alt_text | escape }}"
            >
          {% endif %}

          <picture>
            {% if block.settings.image_mobile != blank %}
              <source
                media="(max-width: 749px)"
                srcset="
                  {{ block.settings.image_mobile | image_url: width: 500 }} 500w,
                  {{ block.settings.image_mobile | image_url: width: 750 }} 750w,
                  {{ block.settings.image_mobile | image_url: width: 1000 }} 1000w
                "
              >
            {% endif %}

            {% if block.settings.image_desktop != blank %}
              {{
                block.settings.image_desktop
                | image_url: width: 1600
                | image_tag:
                  class: 'guara-dual-banner__image',
                  loading: 'lazy',
                  alt: block.settings.alt_text
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg guara-dual-banner__placeholder' }}
            {% endif %}
          </picture>

          {% if block.settings.link != blank %}
            </a>
          {% endif %}
        </div>
      {% endfor %}

    </div>
  </div>
</section>

<style>
  #GuaraDualBanner-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__full {
    width: 100%;
    padding-left: {{ section.settings.side_padding }}px;
    padding-right: {{ section.settings.side_padding }}px;
  }

  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--dual-gap);
  }

  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__item {
    overflow: hidden;
    border-radius: var(--dual-radius);
    min-width: 0;
    height: var(--dual-desktop-height);
  }

  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__link {
    display: block;
    width: 100%;
    height: 100%;
  }

  #GuaraDualBanner-{{ section.id }} picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__image,
  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: center;
  }

  @media screen and (max-width: 749px) {
    #GuaraDualBanner-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #GuaraDualBanner-{{ section.id }} .guara-dual-banner__full {
      padding-left: {{ section.settings.mobile_side_padding }}px;
      padding-right: {{ section.settings.mobile_side_padding }}px;
    }

    #GuaraDualBanner-{{ section.id }} .guara-dual-banner__grid {
      grid-template-columns: 1fr;
      gap: {{ section.settings.mobile_gap }}px;
    }

    #GuaraDualBanner-{{ section.id }} .guara-dual-banner__item {
      height: var(--dual-mobile-height);
    }
  }
</style>

{% if section.settings.enable_mobile_carousel %}

<style>
/* =======================================================
   GUARA MARKET - CARRUSEL DE PROMOCIONES
   Desktop: 2 banners
   Mobile: 1 banner
   ======================================================= */

#GuaraDualBanner-{{ section.id }} .guara-dual-banner__grid {
  display: flex !important;
  grid-template-columns: none !important;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}

#GuaraDualBanner-{{ section.id }} .guara-dual-banner__grid::-webkit-scrollbar {
  display: none;
}

#GuaraDualBanner-{{ section.id }} .guara-dual-banner__item {
  flex: 0 0 calc((100% - var(--dual-gap)) / 2);
  width: calc((100% - var(--dual-gap)) / 2);
  scroll-snap-align: start;
  scroll-snap-stop: always;
}

#GuaraDualBanner-{{ section.id }} .guara-dual-banner__dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 7px;
  margin-top: 14px;
}

#GuaraDualBanner-{{ section.id }} .guara-dual-banner__dot {
  width: 8px;
  height: 8px;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 999px;
  background: #c5cbd3;
  cursor: pointer;
  transition:
    width .25s ease,
    background-color .25s ease,
    transform .25s ease;
}

#GuaraDualBanner-{{ section.id }} .guara-dual-banner__dot.is-active {
  width: 24px;
  background: #2D6493;
}

@media screen and (max-width: 749px) {

  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__grid {
    gap: {{ section.settings.mobile_gap }}px;
  }

  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__item {
    flex: 0 0 100%;
    width: 100%;
  }

  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__dots {
    margin-top: 10px;
  }
}
</style>

<script>
(() => {
  const section = document.getElementById('GuaraDualBanner-{{ section.id }}');

  if (!section || section.dataset.carouselInitialized === 'true') return;

  section.dataset.carouselInitialized = 'true';

  const slider = section.querySelector('.guara-dual-banner__grid');
  const slides = Array.from(
    section.querySelectorAll('.guara-dual-banner__item')
  );

  if (!slider || slides.length < 2) return;

  const autoplayEnabled =
    {{ section.settings.enable_autoplay | json }};

  const autoplayDelay =
    {{ section.settings.autoplay_seconds | default: 5 }} * 1000;

  let currentIndex = 0;
  let autoplayTimer = null;
  let resizeTimer = null;

  /* ---------------------------------------------
     CUÁNTOS BANNERS SE VEN
     --------------------------------------------- */
  const visibleSlides = () => {
    return window.innerWidth <= 749 ? 1 : 2;
  };

  const maxIndex = () => {
    return Math.max(0, slides.length - visibleSlides());
  };

  /* ---------------------------------------------
     INDICADORES
     --------------------------------------------- */
  const dotsContainer = document.createElement('div');
  dotsContainer.className = 'guara-dual-banner__dots';
  dotsContainer.setAttribute('aria-label', 'Promociones');

  slider.insertAdjacentElement('afterend', dotsContainer);

  const buildDots = () => {
    dotsContainer.innerHTML = '';

    const totalPositions = maxIndex() + 1;

    for (let index = 0; index < totalPositions; index++) {
      const dot = document.createElement('button');

      dot.type = 'button';
      dot.className = 'guara-dual-banner__dot';

      if (index === currentIndex) {
        dot.classList.add('is-active');
      }

      dot.setAttribute(
        'aria-label',
        'Ver promoción ' + (index + 1)
      );

      dot.addEventListener('click', () => {
        goToSlide(index);
        restartAutoplay();
      });

      dotsContainer.appendChild(dot);
    }
  };

  const updateDots = () => {
    const dots = dotsContainer.querySelectorAll(
      '.guara-dual-banner__dot'
    );

    dots.forEach((dot, index) => {
      dot.classList.toggle(
        'is-active',
        index === currentIndex
      );
    });
  };

  /* ---------------------------------------------
     MOVER CARRUSEL
     --------------------------------------------- */
  const goToSlide = (index, behavior = 'smooth') => {

    const lastIndex = maxIndex();

    if (index > lastIndex) {
      index = 0;
    }

    if (index < 0) {
      index = lastIndex;
    }

    currentIndex = index;

    const targetSlide = slides[currentIndex];

    if (!targetSlide) return;

    slider.scrollTo({
      left: targetSlide.offsetLeft - slider.offsetLeft,
      behavior
    });

    updateDots();
  };

  /* ---------------------------------------------
     AUTOPLAY
     --------------------------------------------- */
  const stopAutoplay = () => {
    if (autoplayTimer) {
      clearInterval(autoplayTimer);
      autoplayTimer = null;
    }
  };

  const startAutoplay = () => {

    stopAutoplay();

    if (!autoplayEnabled || slides.length < 2) return;

    autoplayTimer = setInterval(() => {

      let nextIndex = currentIndex + 1;

      if (nextIndex > maxIndex()) {
        nextIndex = 0;
      }

      goToSlide(nextIndex);

    }, autoplayDelay);
  };

  const restartAutoplay = () => {
    stopAutoplay();
    startAutoplay();
  };

  /* ---------------------------------------------
     DETECTAR SWIPE MANUAL
     --------------------------------------------- */
  let scrollTimeout;

  slider.addEventListener(
    'scroll',
    () => {

      clearTimeout(scrollTimeout);

      scrollTimeout = setTimeout(() => {

        let closestIndex = 0;
        let closestDistance = Infinity;

        slides.forEach((slide, index) => {

          if (index > maxIndex()) return;

          const distance = Math.abs(
            slider.scrollLeft -
            (slide.offsetLeft - slider.offsetLeft)
          );

          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = index;
          }

        });

        currentIndex = closestIndex;

        updateDots();

      }, 80);

    },
    { passive: true }
  );

  /* ---------------------------------------------
     PAUSAR AL INTERACTUAR
     --------------------------------------------- */
  slider.addEventListener('touchstart', stopAutoplay, {
    passive: true
  });

  slider.addEventListener('touchend', restartAutoplay, {
    passive: true
  });

  section.addEventListener('mouseenter', stopAutoplay);
  section.addEventListener('mouseleave', startAutoplay);

  section.addEventListener('focusin', stopAutoplay);
  section.addEventListener('focusout', startAutoplay);

  /* ---------------------------------------------
     RESPONSIVE
     --------------------------------------------- */
  window.addEventListener('resize', () => {

    clearTimeout(resizeTimer);

    resizeTimer = setTimeout(() => {

      currentIndex = Math.min(
        currentIndex,
        maxIndex()
      );

      buildDots();

      goToSlide(currentIndex, 'auto');

    }, 150);

  });

  /* ---------------------------------------------
     INICIO
     --------------------------------------------- */
  buildDots();
  goToSlide(0, 'auto');
  startAutoplay();

})();
</script>

{% endif %}

{% schema %}
{
  "name": "Guara - Doble banner",
  "tag": "section",
  "class": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_mobile_carousel",
      "label": "Activar carrusel de promociones",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Cambio automático",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_seconds",
      "label": "Tiempo entre promociones",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Ancho completo",
      "default": false
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Alto en desktop",
      "min": 150,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Alto en mobile",
      "min": 120,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Ajuste de imagen",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cubrir"
        },
        {
          "value": "contain",
          "label": "Contener"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Espacio entre banners desktop",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Espacio entre banners mobile",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Bordes redondeados",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Margen lateral desktop",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_side_padding",
      "label": "Margen lateral mobile",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior desktop",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior desktop",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Espacio superior mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Espacio inferior mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Imagen desktop"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Imagen mobile"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Texto alternativo",
          "default": "Banner promocional"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guara - Doble banner",
      "blocks": [
        {
          "type": "banner"
        },
        {
          "type": "banner"
        }
      ]
    }
  ]
}
{% endschema %}

<style>
/* GUARA MARKET - FIX DEFINITIVO BANNERS MOBILE */
@media screen and (max-width: 749px) {

  #GuaraDualBanner-{{ section.id }} {
    width: 100%;
  }

  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__full {
    width: 100%;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__grid {
    width: 100%;
    gap: 0 !important;
  }

  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__item {
    flex: 0 0 100% !important;
    width: 100% !important;
    height: auto !important;
    border-radius: 0 !important;
  }

  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__link,
  #GuaraDualBanner-{{ section.id }} picture {
    display: block;
    width: 100%;
    height: auto !important;
  }

  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__image {
    display: block;
    width: 100% !important;
    height: auto !important;
    max-width: 100%;
    object-fit: contain !important;
    object-position: center;
  }

  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__dots {
    margin-top: 6px !important;
    margin-bottom: 0 !important;
  }
}
</style>
