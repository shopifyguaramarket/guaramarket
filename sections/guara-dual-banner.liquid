<section
  id="GuaraDualBanner-{{ section.id }}"
  class="guara-dual-banner"
  style="
    --dual-gap: {{ section.settings.gap }}px;
    --dual-radius: {{ section.settings.radius }}px;
    --dual-desktop-height: {{ section.settings.desktop_height }}px;
    --dual-mobile-height: {{ section.settings.mobile_height }}px;
  "
>
  <div class="{% if section.settings.full_width %}guara-dual-banner__full{% else %}page-width{% endif %}">
    <div class="guara-dual-banner__grid">

      {% for block in section.blocks %}
        <div
          class="guara-dual-banner__item"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.link != blank %}
            <a
              href="{{ block.settings.link }}"
              class="guara-dual-banner__link"
              aria-label="{{ block.settings.alt_text | escape }}"
            >
          {% endif %}

          <picture>
            {% if block.settings.image_mobile != blank %}
              <source
                media="(max-width: 749px)"
                srcset="
                  {{ block.settings.image_mobile | image_url: width: 500 }} 500w,
                  {{ block.settings.image_mobile | image_url: width: 750 }} 750w,
                  {{ block.settings.image_mobile | image_url: width: 1000 }} 1000w
                "
              >
            {% endif %}

            {% if block.settings.image_desktop != blank %}
              {{
                block.settings.image_desktop
                | image_url: width: 1600
                | image_tag:
                  class: 'guara-dual-banner__image',
                  loading: 'lazy',
                  alt: block.settings.alt_text
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg guara-dual-banner__placeholder' }}
            {% endif %}
          </picture>

          {% if block.settings.link != blank %}
            </a>
          {% endif %}
        </div>
      {% endfor %}

    </div>
  </div>
</section>

<style>
  #GuaraDualBanner-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__full {
    width: 100%;
    padding-left: {{ section.settings.side_padding }}px;
    padding-right: {{ section.settings.side_padding }}px;
  }

  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--dual-gap);
  }

  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__item {
    overflow: hidden;
    border-radius: var(--dual-radius);
    min-width: 0;
    height: var(--dual-desktop-height);
  }

  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__link {
    display: block;
    width: 100%;
    height: 100%;
  }

  #GuaraDualBanner-{{ section.id }} picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__image,
  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: center;
  }

  @media screen and (max-width: 749px) {
    #GuaraDualBanner-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #GuaraDualBanner-{{ section.id }} .guara-dual-banner__full {
      padding-left: {{ section.settings.mobile_side_padding }}px;
      padding-right: {{ section.settings.mobile_side_padding }}px;
    }

    #GuaraDualBanner-{{ section.id }} .guara-dual-banner__grid {
      grid-template-columns: 1fr;
      gap: {{ section.settings.mobile_gap }}px;
    }

    #GuaraDualBanner-{{ section.id }} .guara-dual-banner__item {
      height: var(--dual-mobile-height);
    }
  }
</style>

{% if section.settings.enable_mobile_carousel %}
<style>
/* GUARA DOBLE BANNER - CARRUSEL MOBILE */
@media screen and (max-width: 749px) {
  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__grid {
    display: flex !important;
    grid-template-columns: none !important;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: {{ section.settings.mobile_gap }}px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__grid::-webkit-scrollbar {
    display: none;
  }

  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__item {
    flex: 0 0 100%;
    width: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
}

@media screen and (min-width: 750px) {
  #GuaraDualBanner-{{ section.id }} .guara-dual-banner__dots {
    display: none;
  }
}

.guara-dual-banner__dots {
  justify-content: center;
  align-items: center;
  gap: 7px;
  margin-top: 10px;
}

@media screen and (max-width: 749px) {
  .guara-dual-banner__dots {
    display: flex;
  }
}

.guara-dual-banner__dot {
  width: 8px;
  height: 8px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #c7c7c7;
  cursor: pointer;
}

.guara-dual-banner__dot.is-active {
  width: 20px;
  border-radius: 999px;
  background: #2D6493;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const section = document.querySelector('#GuaraDualBanner-{{ section.id }}');
  if (!section) return;

  const slider = section.querySelector('.guara-dual-banner__grid');
  const slides = section.querySelectorAll('.guara-dual-banner__item');

  if (!slider || slides.length < 2) return;

  const dotsContainer = document.createElement('div');
  dotsContainer.className = 'guara-dual-banner__dots';

  slides.forEach((slide, index) => {
    const dot = document.createElement('button');
    dot.type = 'button';
    dot.className =
      'guara-dual-banner__dot' + (index === 0 ? ' is-active' : '');
    dot.setAttribute('aria-label', 'Ver banner ' + (index + 1));

    dot.addEventListener('click', function () {
      slider.scrollTo({
        left: slide.offsetLeft,
        behavior: 'smooth'
      });
    });

    dotsContainer.appendChild(dot);
  });

  slider.insertAdjacentElement('afterend', dotsContainer);

  const dots = dotsContainer.querySelectorAll('.guara-dual-banner__dot');

  slider.addEventListener('scroll', function () {
    const slideWidth = slider.clientWidth;
    if (!slideWidth) return;

    const index = Math.round(slider.scrollLeft / slideWidth);

    dots.forEach((dot, dotIndex) => {
      dot.classList.toggle('is-active', dotIndex === index);
    });
  }, { passive: true });
});
</script>
{% endif %}

{% schema %}
{
  "name": "Guara - Doble banner",
  "tag": "section",
  "class": "section",
  "max_blocks": 2,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_mobile_carousel",
      "label": "Activar carrusel en mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Ancho completo",
      "default": false
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Alto en desktop",
      "min": 150,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Alto en mobile",
      "min": 120,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Ajuste de imagen",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cubrir"
        },
        {
          "value": "contain",
          "label": "Contener"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Espacio entre banners desktop",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Espacio entre banners mobile",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Bordes redondeados",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Margen lateral desktop",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_side_padding",
      "label": "Margen lateral mobile",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior desktop",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior desktop",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Espacio superior mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Espacio inferior mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Imagen desktop"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Imagen mobile"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Texto alternativo",
          "default": "Banner promocional"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guara - Doble banner",
      "blocks": [
        {
          "type": "banner"
        },
        {
          "type": "banner"
        }
      ]
    }
  ]
}
{% endschema %}
