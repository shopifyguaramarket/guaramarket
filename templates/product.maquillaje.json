nter; border: 2px solid #a3208d; border-radius: 10px; padding: 8px 15px; max-width: 600px; margin: 0 auto; font-family: sans-serif;\">\n  <div style=\"flex-shrink: 0; margin-right: 12px;\">\n    <img src=\"https:\/\/cdn-icons-png.flaticon.com\/512\/190\/190411.png\" alt=\"Garantía\" style=\"width: 32px; height: 32px;\">\n  <\/div>\n  <div style=\"line-height: 1.3;\">\n    <p style=\"margin: 0; font-weight: bold; color: #a3208d; font-size: 15px;\">\n      Garantía de 14 Días 🇵🇾\n    <\/p>\n    <p style=\"margin: 0; color: #333; font-size: 14px;\">\n      Así de seguros estamos de tus resultados. Si no estás satisfecha, devolvelo y te reembolsamos tu compra.\n    <\/p>\n  <\/div>\n<\/div>"}},"custom_liquid_cq98ne":{"type":"custom_liquid","name":"Contador","settings":{"custom_liquid":"<div style=\"text-align: center; font-family: sans-serif; padding: 20px;\">\n  <h2 style=\"color: #ffd8b7; font-size: 22px; font-weight: bold;\">\n    ¡Tu Moisture Cushion Base espera por vos ⏳Envíos Gratuitos!\n  <\/h2>\n  <h2 style=\"color: #880e94; font-size: 22px; font-weight: bold;\">\n    \n  <\/h2>\n\n  <div style=\"margin: 10px 0;\">\n    <img src=\"https:\/\/cdn-icons-png.flaticon.com\/512\/197\/197591.png\" alt=\"Paraguay flag\" style=\"width: 40px; height: auto;\" \/>\n  <\/div>\n\n  <div id=\"countdown\" style=\"display: flex; justify-content: center; gap: 10px; margin-top: 10px;\">\n    <div style=\"background: linear-gradient(to bottom, #ffd8b7); color: white; padding: 5px 14px; border-radius: 8px; min-width: 60px; height: 60px; display: flex; flex-direction: column; justify-content: center;\">\n      <div id=\"hours\" style=\"font-size: 20px; font-weight: bold; line-height: 1;\">00<\/div>\n      <div style=\"font-size: 12px; line-height: 1;\">hr<\/div>\n    <\/div>\n    <div style=\"background: linear-gradient(to bottom, #ffd8b7, #ffd8b7); color: white; padding: 5px 14px; border-radius: 8px; min-width: 60px; height: 60px; display: flex; flex-direction: column; justify-content: center;\">\n      <div id=\"minutes\" style=\"font-size: 20px; font-weight: bold; line-height: 1;\">00<\/div>\n      <div style=\"font-size: 12px; line-height: 1;\">min<\/div>\n    <\/div>\n    <div style=\"background: linear-gradient(to bottom, #ffd8b7, #ffd8b7); color: white; padding: 5px 14px; border-radius: 8px; min-width: 60px; height: 60px; display: flex; flex-direction: column; justify-content: center;\">\n      <div id=\"seconds\" style=\"font-size: 20px; font-weight: bold; line-height: 1;\">00<\/div>\n      <div style=\"font-size: 12px; line-height: 1;\">seg<\/div>\n    <\/div>\n  <\/div>\n<\/div>\n\n<script>\n  function startCountdown(duration) {\n    let timer = duration;\n\n    setInterval(function () {\n      let hours = Math.floor(timer \/ 3600);\n      let minutes = Math.floor((timer % 3600) \/ 60);\n      let seconds = timer % 60;\n\n      document.getElementById(\"hours\").textContent = hours < 10 ? \"0\" + hours : hours;\n      document.getElementById(\"minutes\").textContent = minutes < 10 ? \"0\" + minutes : minutes;\n      document.getElementById(\"seconds\").textContent = seconds < 10 ? \"0\" + seconds : seconds;\n\n      timer--;\n\n      if (timer < 0) {\n        timer = duration; \/\/ Reinicia automáticamente\n      }\n    }, 1000);\n  }\n\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const fiveHours = 5 * 60 * 60; \/\/ 5 horas en segundos\n    startCountdown(fiveHours);\n  });\n<\/script>"}},"custom_liquid_bm8XNL":{"type":"custom_liquid","settings":{"custom_liquid":"<style>\n.faq-accordion {\n  max-width: 600px;\n  margin: 0 auto;\n  font-family: \"Helvetica Neue\", sans-serif;\n  border: 1px solid #e0e0e0;\n  border-radius: 4px;\n  overflow: hidden;\n}\n\n.faq-item {\n  border-bottom: 1px solid #e0e0e0;\n}\n\n.faq-question {\n  background: #fff;\n  padding: 15px 20px;\n  cursor: pointer;\n  font-weight: bold;\n  position: relative;\n  font-size: 16px;\n}\n\n.faq-question::after {\n  content: \"+\";\n  position: absolute;\n  right: 20px;\n  font-size: 18px;\n  transition: transform 0.3s ease;\n}\n\n.faq-question.active::after {\n  content: \"×\";\n}\n\n.faq-answer {\n  display: none;\n  padding: 15px 20px;\n  background-color: #fafafa;\n  color: #333;\n  font-size: 15px;\n  line-height: 1.5;\n}\n<\/style>\n\n<div class=\"faq-accordion\">\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">¿Qué cobertura tiene?<\/div>\n    <div class=\"faq-answer\">Ofrece una cobertura ligera a media para un acabado natural y fresco.<\/div>\n  <\/div>\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">¿Cómo aplicarla correctamente?<\/div>\n    <div class=\"faq-answer\">Presioná la esponja sobre la almohadilla y aplicá a toques desde el centro hacia afuera.<\/div>\n  <\/div>\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">¿En qué tipo de piel funciona mejor?<\/div>\n    <div class=\"faq-answer\">Ideal para pieles normales, secas y mixtas por su efecto hidratante.<\/div>\n  <\/div>\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">¿Cuánto dura puesta?<\/div>\n    <div class=\"faq-answer\">Formulada para el día a día con durabilidad moderada y retoques mínimos.<\/div>\n  <\/div>\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">¿Aporta luminosidad?<\/div>\n    <div class=\"faq-answer\">Sí, brinda un glow natural que realza la piel sin brillos excesivos.<\/div>\n  <\/div>\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">¿Oxida con el tiempo?<\/div>\n    <div class=\"faq-answer\">Pensada para mantener el tono. Dejá asentar 2–3 minutos para confirmar el match.<\/div>\n  <\/div>\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">¿Cómo retirarla?<\/div>\n    <div class=\"faq-answer\">Usá desmaquillante suave y luego limpieza facial.<\/div>\n  <\/div>\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">¿Rinde cuántas aplicaciones?<\/div>\n    <div class=\"faq-answer\">Con uso moderado, 4–6 semanas aprox.<\/div>\n  <\/div>\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">¿Apta uso diario?<\/div>\n    <div class=\"faq-answer\">Sí, textura ligera y confortable para todo el día.<\/div>\n  <\/div>\n<\/div>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const questions = document.querySelectorAll(\".faq-question\");\n\n    questions.forEach((question) => {\n      question.addEventListener(\"click\", () => {\n        const isActive = question.classList.contains(\"active\");\n\n        document.querySelectorAll(\".faq-question\").forEach(q => q.classList.remove(\"active\"));\n        document.querySelectorAll(\".faq-answer\").forEach(a => a.style.display = \"none\");\n\n        if (!isActive) {\n          question.classList.add(\"active\");\n          question.nextElementSibling.style.display = \"block\";\n        }\n      });\n    });\n  });\n<\/script>"}},"variant_picker":{"type":"variant_picker","settings":{"picker_type":"button","swatch_shape":"circle"}},"description":{"type":"description","settings":{}},"custom_liquid_847F9P":{"type":"custom_liquid","settings":{"custom_liquid":"<div style=\"background-color: #e5b698; color: #f5eee8; padding: 20px; border-radius: 15px; font-family: Arial, sans-serif;\">\n  <div style=\"display: flex; align-items: flex-start; margin-bottom: 20px;\">\n    <span style=\"font-size: 24px; margin-right: 10px;\">🕒<\/span>\n    <div>\n      <strong style=\"font-size: 16px; display: block;\">Aplicación rápida<\/strong>\n      <span style=\"font-size: 14px;\">Con su formato cushion, lográs una base perfecta en segundos.<\/span>\n    <\/div>\n  <\/div>\n\n  <div style=\"display: flex; align-items: flex-start; margin-bottom: 20px;\">\n    <span style=\"font-size: 24px; margin-right: 10px;\">🛡<\/span>\n    <div>\n      <strong style=\"font-size: 16px; display: block;\">Larga duración<\/strong>\n      <span style=\"font-size: 14px;\">Resiste al sudor y a la humedad para mantener tu piel impecable.<\/span>\n    <\/di